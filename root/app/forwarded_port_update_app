# shellcheck shell=bash
until pidof slskd > /dev/null; do   
    sleep 1
done
pid=$(pidof slskd)
old_port=$(yq '.soulseek.listen_port' "${CONFIG_DIR}/slskd.yml")
if [[ "${old_port}" != "${port}" ]]; then
    yq -i '.soulseek.listen_port = "'"${port}"'"' "${CONFIG_DIR}/slskd.yml"
    log_inf "[SLSKD] Shutting down to restart with forwarded port [${port}]."
    kill "${pid}"
else
    log_inf "[SLSKD] Nothing to do, forwarded port hasn't changed."
fi
